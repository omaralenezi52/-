# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git أبداً.

# توكن سري إلزامي — يجب أن يطابقه كل طلب Webhook من TradingView (اجعله طويلاً وعشوائياً)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# وضع التشغيل: ADVISOR | SEMI_AUTO | FULL_AUTO  (ابدأ بـ ADVISOR)
TRADE_MODE=ADVISOR

# تليجرام
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# مفتاح الـ LLM لطبقة الذكاء (اتركه فارغاً ⇒ النظام يعمل بمحلل محايد آمن)
ANTHROPIC_API_KEY=
# نموذج المحلل (افتراضي claude-opus-5)
ANALYST_MODEL=claude-opus-5

# اختيار المنصة: paper | ibkr | derayah
BROKER=paper

# Interactive Brokers — تحط بياناتك هنا (المنفذ 7497 = Paper، 7496 = Live)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
